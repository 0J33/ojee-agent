# The tmux server that hosts every Claude Code session.
#
# Its own unit so that restarting or redeploying the runner never touches a
# running session: the sessions are this unit's children, not the runner's.
# The limits below are for ALL sessions together — this box also runs the
# console, Caddy, n8n and the home hub, and a runaway build must not take
# those down with it.
#
# Installed by claude-runner/deploy/install.sh (@ROOT@, @TMUX@ filled in).

[Unit]
Description=ojee-claude tmux server (hosts Claude Code sessions)
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:@NODEDIR@:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
# A server already on the socket when this unit starts is a stray (the unit's
# own died with it), and with it there `tmux -D` fails "not a terminal" and
# the unit loops for ever. Clear it first.
ExecStartPre=-@TMUX@ -L ojee-claude kill-server
ExecStart=@TMUX@ -L ojee-claude -f @ROOT@/deploy/tmux.conf -D
ExecStop=@TMUX@ -L ojee-claude kill-server
Restart=on-failure
RestartSec=5
# No MemoryHigh: throttling at a soft limit stalls the sessions on reclaim,
# and that stall is memory pressure, which is exactly what systemd-oomd acts
# on -- by killing this whole unit, every session in it (2026-10-22, twice).
# The hard cap stays: past it the kernel kills the one biggest process.
MemoryMax=10G
# Ask oomd to pick something else (honoured where systemd supports it for
# user units).
ManagedOOMPreference=avoid
CPUWeight=50
TasksMax=4096

[Install]
WantedBy=default.target
